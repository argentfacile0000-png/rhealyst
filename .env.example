# =====================================================================
#  StoryForge — configuration (copie ce fichier en .env et remplis-le)
# =====================================================================

# --- Telegram ---------------------------------------------------------
# Token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Ton ID Telegram (envoie /myid au bot pour le connaître). Plusieurs : 111,222
TELEGRAM_ADMIN_IDS=

# --- OpenAI (ChatGPT) — écriture des histoires -------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=            # optionnel (proxy / API compatible)
# OPENAI_TEMPERATURE=0.95

# --- ElevenLabs — voix off ---------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voix par défaut des nouvelles chaînes (modifiable par chaîne dans le dashboard)
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_DEFAULT_VOICE_NAME=Adam

# --- YouTube (Google Cloud → API YouTube Data v3 → client OAuth "Application de bureau")
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8765/

# --- TikTok (developers.tiktok.com → Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL de redirection déclarée dans ton app TikTok (https obligatoire)
TIKTOK_REDIRECT_URI=

# --- Rendu vidéo -------------------------------------------------------
# DATA_DIR=data
# VIDEO_CRF=20
# VIDEO_PRESET=veryfast
# MAX_CONCURRENT_RENDERS=1
# KEEP_VIDEOS_DAYS=7
TIMEZONE=Europe/Paris

# --- Mini App Telegram (dashboard visuel, optionnel) -------------------
# Nécessite une URL publique HTTPS qui pointe vers WEBAPP_PORT (reverse proxy, Cloudflare Tunnel…)
WEBAPP_ENABLED=false
WEBAPP_PORT=8080
PUBLIC_URL=
