# =====================================================================
#  StoryForge — configuration (copie ce fichier en .env et remplis-le)
# =====================================================================

# --- Telegram ---------------------------------------------------------
# Token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Ton ID Telegram (envoie /myid au bot pour le connaître). Plusieurs : 111,222
TELEGRAM_ADMIN_IDS=

# --- IA qui écrit les histoires ----------------------------------------
# Une seule clé suffit. Gemini et Groq ont une offre gratuite (sans carte bancaire).
#   Gemini : https://aistudio.google.com/apikey
#   Groq   : https://console.groq.com/keys
#   OpenAI : https://platform.openai.com/api-keys (payant)
# Fournisseur : auto | gemini | groq | openai
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Modèle (vide = gemini-flash-latest / llama-3.3-70b-versatile / gpt-4.1)
# LLM_MODEL=
# Autre API compatible OpenAI (optionnel)
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0.95

# --- ElevenLabs — voix off ---------------------------------------------
ELEVENLABS_API_KEY=
# Clés de secours (utilisées quand la précédente n'a plus de crédits), séparées par des virgules.
# On peut aussi en ajouter depuis le bot : Réglages → Clés ElevenLabs.
ELEVENLABS_API_KEYS=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voix par défaut des nouvelles chaînes (modifiable par chaîne dans le dashboard)
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_DEFAULT_VOICE_NAME=Adam

# --- YouTube (Google Cloud → API YouTube Data v3 → client OAuth)
# Client "Application Web" + PUBLIC_URL : connexion en un clic (URI de retour : <PUBLIC_URL>/oauth/youtube)
# Client "Application de bureau" : on colle l'adresse de retour (localhost) dans le bot ou la page de connexion
GOOGLE_CLIENT_SECRETS_FILE=secrets/google_client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8765/

# --- TikTok (developers.tiktok.com → Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URI de retour déclarée dans ton app TikTok (https obligatoire).
# Laisse vide avec PUBLIC_URL : <PUBLIC_URL>/oauth/tiktok est utilisé automatiquement.
TIKTOK_REDIRECT_URI=

# --- Instagram (developers.facebook.com → produit Instagram, connexion Instagram) ---
# Nécessite PUBLIC_URL en https : Instagram télécharge les vidéos sur le serveur.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=   (vide = <PUBLIC_URL>/oauth/instagram)
# INSTAGRAM_API_VERSION=v26.0

# --- Mises à jour automatiques depuis GitHub (serveur installé avec deploy/install.sh) ---
# AUTO_UPDATE=false

# --- Rendu vidéo -------------------------------------------------------
# DATA_DIR=data
# VIDEO_CRF=20
# VIDEO_PRESET=veryfast
# MAX_CONCURRENT_RENDERS=1
# KEEP_VIDEOS_DAYS=7
TIMEZONE=Europe/Paris

# --- Serveur web : Mini App + page de connexion des comptes -------------
# Nécessite une URL publique HTTPS qui pointe vers WEBAPP_PORT (reverse proxy, Cloudflare Tunnel, ngrok…)
WEBAPP_ENABLED=false
WEBAPP_PORT=8080
PUBLIC_URL=
# Clé de signature des liens de connexion (optionnel, dérivée du token Telegram par défaut)
# SECRET_KEY=
